# Database — this is a TEMPLATE file (tracked in git). Copy it to .env
# (gitignored) and put your real local Postgres password there, not here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# AngelOne SmartAPI (broker + live/historical market data) — free for
# retail accounts, no separate API subscription.
#
# NEVER type these into a chat session with an AI assistant, including this
# one — fill them in yourself, directly in this file (or wherever your
# secrets manager puts them), and run scripts/angelone_check_auth.py
# yourself to verify the setup without ever pasting the values anywhere.
#
# ANGEL_API_KEY:         create an app at https://smartapi.angelbroking.com
# ANGEL_CLIENT_CODE:     your AngelOne client ID (e.g. "A123456")
# ANGEL_PASSWORD_OR_PIN: your AngelOne trading PIN
# ANGEL_TOTP_SECRET:     the base32 secret shown when you enable TOTP in the
#                        AngelOne app (Profile -> Settings -> Enable TOTP) —
#                        this is the secret, NOT a 6-digit code; the app
#                        computes fresh codes from it automatically.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD_OR_PIN=
ANGEL_TOTP_SECRET=

# Trade mode: "paper" (default, simulated) or "angelone" (real orders)
TRADE_MODE=paper

# Trading Parameters
INITIAL_CAPITAL=50000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=0.05
SCORE_THRESHOLD=0.6

# Optional — free tier, only needed for global-market enrichment on the
# News Brief tab. Leave blank to skip that section entirely.
# ALPHA_VANTAGE_API_KEY=

# Model
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
